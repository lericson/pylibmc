#!/usr/bin/env python3
"""Build docs/changelog.rst entries from the fragments in changes.d/.

    bin/changelog check [--version X.Y.Z]
    bin/changelog build X.Y.Z [--write]

See changes.d/README.rst for the file format. Standard library only.
"""
import argparse
import os
import re
import sys
import textwrap

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FRAGMENT_DIR = os.path.join(ROOT, "changes.d")
CHANGELOG = os.path.join(ROOT, "docs", "changelog.rst")

# Category -> heading, in the order a release lists them.
CATEGORIES = [
    ("breaking", "Changes that can break existing code:"),
    ("new", "New:"),
    ("fix", "Fixes:"),
    ("build", "Build and platforms:"),
    ("docs", "Documentation:"),
]
HEADINGS = dict(CATEGORIES)
NAME_RE = re.compile(
    r"^(?P<id>\d+|\+[A-Za-z0-9_-]+)\.(?P<cat>%s)\.rst$"
    % "|".join(c for c, _ in CATEGORIES))
WIDTH = 80
VERSION_RE = re.compile(r"^(\d+)\.(\d+)\.(\d+)(?:[-.]?[A-Za-z][A-Za-z0-9.]*)?$")
# Categories a patch release (X.Y.Z with Z > 0) may not contain.
MINOR_ONLY = ("breaking", "new")


class Fragment:
    def __init__(self, name, ident, category, text):
        self.name = name
        self.ident = ident
        self.category = category
        self.text = text

    @property
    def number(self):
        return int(self.ident) if self.ident.isdigit() else None

    def sort_key(self):
        n = self.number
        return (0, n, "") if n is not None else (1, 0, self.ident)

    def bullet(self):
        text = " ".join(self.text.split())
        n = self.number
        if n is not None and not re.search(r"#%d(?!\d)" % n, text):
            tail = "."
            if text.endswith("."):
                text = text[:-1]
            else:
                tail = ""
            text = "%s (#%d)%s" % (text, n, tail)
        return textwrap.fill(
            text, WIDTH, initial_indent="- ", subsequent_indent="  ",
            break_long_words=False, break_on_hyphens=False)


def load(directory=FRAGMENT_DIR):
    """Return (fragments, errors) for the directory."""
    frags, errors = [], []
    for name in sorted(os.listdir(directory)):
        if name.startswith(".") or name == "README.rst":
            continue
        path = os.path.join(directory, name)
        if os.path.isdir(path):
            errors.append("%s: unexpected directory" % name)
            continue
        m = NAME_RE.match(name)
        if not m:
            errors.append(
                "%s: name must be <number>.<category>.rst or "
                "+<word>.<category>.rst, category one of %s"
                % (name, ", ".join(c for c, _ in CATEGORIES)))
            continue
        with open(path, encoding="utf-8") as f:
            text = f.read().strip()
        if not text:
            errors.append("%s: empty" % name)
            continue
        if text.startswith("- ") or text.startswith("* "):
            errors.append("%s: text must not start with a bullet marker" % name)
            continue
        frags.append(Fragment(name, m.group("id"), m.group("cat"), text))
    return frags, errors


def bullets_by_category(frags):
    out = {}
    for cat, _ in CATEGORIES:
        sel = sorted((f for f in frags if f.category == cat),
                     key=Fragment.sort_key)
        if sel:
            out[cat] = [f.bullet() for f in sel]
    return out


def render_blocks(blocks):
    """Join {category: [bullet text]} in release order."""
    return "\n\n".join(heading + "\n\n" + "\n".join(blocks[cat])
                       for cat, heading in CATEGORIES if cat in blocks) + "\n"


def title(version):
    t = "New in version %s" % version
    return t + "\n" + "-" * len(t) + "\n"


def build_section(version, frags):
    return title(version) + "\n" + render_blocks(bullets_by_category(frags))


def insert_into_changelog(text, version, frags):
    """Return changelog text with the fragments added under version."""
    new = bullets_by_category(frags)
    lines = text.split("\n")
    head = "New in version %s" % version
    start = None
    for i in range(len(lines) - 1):
        if lines[i] == head and re.match(r"^-+$", lines[i + 1]):
            start = i
            break
    if start is None:
        # New section directly under the page title ("Change Log", "====").
        at = 0
        for i in range(len(lines) - 1):
            if re.match(r"^=+$", lines[i + 1]) and lines[i]:
                at = i + 2
                break
        section = build_section(version, frags)
        before = "\n".join(lines[:at]).rstrip("\n") + "\n\n"
        after = "\n".join(lines[at:]).lstrip("\n")
        return before + section + "\n" + after
    end = len(lines)
    for i in range(start + 2, len(lines) - 1):
        if (lines[i].startswith("New in version ")
                and re.match(r"^-+$", lines[i + 1])):
            end = i
            break
    lines[start + 2:end] = merge_section_body(lines[start + 2:end], new)
    return "\n".join(lines)


def is_list_line(line):
    """True for a bullet item or a line inside one (indented text)."""
    return (line.startswith(("- ", "* ", "+ ", " ", "\t"))
            or line in ("-", "*", "+"))


def list_end(body, h, stop):
    """Index just past the bullet list under the heading at body[h]."""
    end = h + 1
    i = h + 1
    while i < stop and not body[i].strip():
        i += 1
    if i < stop and body[i].startswith(("- ", "* ", "+ ")):
        while i < stop and (not body[i].strip() or is_list_line(body[i])):
            if body[i].strip():
                end = i + 1
            i += 1
    return end


def merge_section_body(body, new):
    """Add {category: [bullet]} to the lines of an existing section.

    New bullets go at the end of their category's list; a missing category
    gets its heading in release order among the existing ones. Everything
    else (intro, closing paragraphs, comments) stays where it is.
    """
    by_heading = {h: c for c, h in CATEGORIES}
    heads = [(i, by_heading[l]) for i, l in enumerate(body) if l in by_heading]
    order = [c for c, _ in CATEGORIES]
    ends = {}
    for k, (h, cat) in enumerate(heads):
        stop = heads[k + 1][0] if k + 1 < len(heads) else len(body)
        ends[cat] = list_end(body, h, stop)
    content = [i for i, l in enumerate(body) if l.strip()]
    tail = content[-1] + 1 if content else 0
    inserts = {}   # index -> lines, filled in release order
    for cat in order:
        if cat not in new:
            continue
        bullets = "\n".join(new[cat]).split("\n")
        if cat in ends:
            h = [i for i, c in heads if c == cat][0]
            at = ends[cat]
            chunk = bullets if at > h + 1 else [""] + bullets
            inserts.setdefault(at, []).append(chunk)
            continue
        later = [i for i, c in heads if order.index(c) > order.index(cat)]
        earlier = [c for _, c in heads if order.index(c) < order.index(cat)]
        if later:
            at = min(later)
            chunk = [HEADINGS[cat], ""] + bullets + [""]
        else:
            at = ends[earlier[-1]] if earlier else tail
            chunk = ["", HEADINGS[cat], ""] + bullets
        inserts.setdefault(at, []).append(chunk)
    for at in sorted(inserts, reverse=True):
        add = []
        for chunk in inserts[at]:
            prev = add[-1] if add else (body[at - 1] if at else "")
            # A heading needs a blank line before it; bullets join the list.
            if prev.strip() and chunk[0].strip() and chunk[0] in by_heading:
                add.append("")
            add.extend(chunk)
        if at < len(body) and body[at].strip() and add[-1].strip():
            add.append("")
        body[at:at] = add
    if body and body[-1].strip():
        body.append("")
    return body


def parse_version(text):
    """Return (major, minor, patch) of "1.8.1", "1.8.1rc1", "1.8.0-dev"."""
    m = VERSION_RE.match(text)
    if not m:
        raise ValueError("cannot parse version %r: want X.Y.Z with an "
                         "optional suffix such as -dev or rc1" % text)
    return tuple(int(g) for g in m.groups())


def is_patch_release(version):
    return parse_version(version)[2] > 0


def semver_errors(version, frags):
    """Messages for fragments a patch release version may not contain."""
    if not is_patch_release(version):
        return []
    bad = sorted(f.name for f in frags if f.category in MINOR_ONLY)
    if not bad:
        return []
    return ["version %s is a patch release, which may only contain fix, "
            "build and docs fragments, but these are breaking or new: %s. "
            "Move them to a minor release (X.Y.0) or reclassify them."
            % (version, ", ".join("changes.d/" + n for n in bad))]


def cmd_check(args):
    frags, errors = load(args.dir)
    for e in errors:
        print("changes.d/" + e, file=sys.stderr)
    if errors:
        return 1
    try:
        problems = semver_errors(args.version, frags) if args.version is not None else []
    except ValueError as e:
        print("error: %s" % e, file=sys.stderr)
        return 2
    for e in problems:
        print("error: " + e, file=sys.stderr)
    if problems:
        return 1
    print("%d fragment(s) ok%s" % (
        len(frags), " for version " + args.version if args.version is not None else ""))
    return 0


def cmd_build(args):
    if not re.match(r"^\d+\.\d+\.\d+$", args.version):
        print("version must look like 1.8.0", file=sys.stderr)
        return 2
    frags, errors = load(args.dir)
    if errors:
        for e in errors:
            print("changes.d/" + e, file=sys.stderr)
        return 1
    problems = semver_errors(args.version, frags)
    for e in problems:
        print("error: " + e, file=sys.stderr)
    if problems:
        return 1
    if not frags:
        print("no fragments", file=sys.stderr)
        return 1
    consumed = sorted(frags, key=lambda f: (f.category, f.sort_key()))
    listing = "".join("changes.d/%s\n" % f.name for f in consumed)
    if args.write:
        with open(CHANGELOG, encoding="utf-8") as f:
            text = f.read()
        with open(CHANGELOG, "w", encoding="utf-8") as f:
            f.write(insert_into_changelog(text, args.version, frags))
        print("Wrote docs/changelog.rst. Review it, then delete:")
        sys.stdout.write(listing)
    else:
        sys.stdout.write(build_section(args.version, frags))
        print("\nConsumed fragments (delete in the release commit):",
              file=sys.stderr)
        sys.stderr.write(listing)
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    p.add_argument("--dir", default=FRAGMENT_DIR, help=argparse.SUPPRESS)
    sub = p.add_subparsers(dest="cmd")
    sub.required = True
    c = sub.add_parser("check", help="validate the fragments")
    c.add_argument("--version", help="also apply the release rules for this "
                   "version: a patch release (Z > 0) may not carry breaking "
                   "or new fragments (the release workflow passes the tag)")
    c.set_defaults(func=cmd_check)
    b = sub.add_parser("build", help="print or write a release section")
    b.add_argument("version")
    b.add_argument("--write", action="store_true",
                   help="insert into docs/changelog.rst")
    b.set_defaults(func=cmd_build)
    args = p.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
